#!/bin/sh
# atomrust-overlay: switch the root filesystem between read-write and a
# read-only SD card with a RAM (tmpfs) overlay, so nothing writes to the card.
#
#   atomrust-ro      configure read-only mode (takes effect after reboot)
#   atomrust-rw      configure read-write mode (takes effect after reboot)
#   atomrust-overlay status
#
# Add --reboot to ro/rw to reboot immediately.
#
# Read-only mode uses the Debian `overlayroot` initramfs hook (the same one
# raspi-config uses): the SD root is mounted read-only at /media/root-ro and all
# writes go to tmpfs and vanish on reboot. It also:
#   - mounts /boot/firmware read-only
#   - keeps the journal in RAM (capped)
#   - switches rpi-swap to zram only (no writeback file on the card)
#   - disables timers that would write or download (apt, man-db, ...)
# atomrust-rw undoes all of that, even when run from inside read-only mode.
set -eu

BOOT=/boot/firmware
CMDLINE=$BOOT/cmdline.txt
LOWER=/media/root-ro
STATE=var/lib/atomrust/ro-disabled-timers
JOURNALD_DROPIN=etc/systemd/journald.conf.d/90-atomrust-ro.conf
SWAP_DROPIN=etc/rpi/swap.conf.d/90-atomrust-ro.conf
TIMERS="apt-daily.timer apt-daily-upgrade.timer man-db.timer dpkg-db-backup.timer e2scrub_all.timer"

die() { echo "error: $*" >&2; exit 1; }
say() { echo "atomrust: $*"; }

need_root() { [ "$(id -u)" = 0 ] || die "must be run as root (sudo $PROG)"; }

overlay_active() { grep -qw 'overlayroot=tmpfs' /proc/cmdline && [ "$(findmnt -n -o FSTYPE /)" = overlay ]; }
overlay_configured() { grep -qw 'overlayroot=tmpfs' "$CMDLINE"; }

# Run "$@" with $BOOT writable, restoring its previous mount state after.
with_boot_rw() {
	was_ro=0
	if findmnt -n -o OPTIONS "$BOOT" | grep -qE '(^|,)ro(,|$)'; then
		mount -o remount,rw "$BOOT" || die "cannot remount $BOOT read-write"
		was_ro=1
	fi
	"$@"
	sync
	[ "$was_ro" = 1 ] && mount -o remount,ro "$BOOT" || true
}

cmdline_add() { sed -i -E '1 s/^/overlayroot=tmpfs /' "$CMDLINE"; }
cmdline_del() { cmdline_del_at "$CMDLINE"; }
cmdline_del_at() { sed -i -E 's/(^| )overlayroot=tmpfs( |$)/\1/; s/^ +//; s/ +$//' "$1"; }

# Add (ro) or remove (rw) the "ro" mount option on the $BOOT line of an fstab.
fstab_boot_opt() {
	awk -v b="$BOOT" -v mode="$1" '
		$1 !~ /^#/ && $2 == b {
			n = split($4, o, ","); opts = ""; has = 0
			for (i = 1; i <= n; i++) {
				if (o[i] == "ro") { has = 1; continue }
				opts = opts (opts == "" ? "" : ",") o[i]
			}
			if (mode == "ro") opts = opts ",ro"
			if (mode == "ro" && has) opts = $4
			$4 = opts
		}
		{ print }' "$2" > "$2.atomrust.tmp" && mv "$2.atomrust.tmp" "$2"
}

# Every installed kernel's initramfs must contain the overlayroot hook, not just
# the running one: after a kernel upgrade the next boot uses the new kernel.
ensure_initramfs() {
	dpkg-query -W -f='${Status}' overlayroot 2>/dev/null | grep -q 'ok installed' \
		|| die "the overlayroot package is not installed (sudo apt install overlayroot)"
	grep -qE '^\s*auto_initramfs=1' "$BOOT/config.txt" \
		|| die "auto_initramfs=1 is not set in $BOOT/config.txt; the firmware would not load the initramfs"
	found=0
	for img in /boot/initrd.img-*; do
		[ -e "$img" ] || continue
		found=1
		ver=${img#/boot/initrd.img-}
		if ! lsinitramfs "$img" 2>/dev/null | grep -q overlayroot; then
			say "adding overlayroot to initramfs for $ver"
			update-initramfs -u -k "$ver"
		fi
	done
	[ "$found" = 1 ] || die "no initramfs found in /boot"
}

do_ro() {
	if overlay_active; then say "already in read-only mode"; exit 0; fi
	if overlay_configured; then say "read-only mode already configured; reboot to activate"; maybe_reboot; exit 0; fi
	ensure_initramfs

	mkdir -p /etc/systemd/journald.conf.d /var/lib/atomrust
	printf '# Written by atomrust-ro; removed by atomrust-rw.\n[Journal]\nStorage=volatile\nRuntimeMaxUse=32M\n' \
		> "/$JOURNALD_DROPIN"
	if [ -d /etc/rpi ]; then
		mkdir -p /etc/rpi/swap.conf.d
		printf '# Written by atomrust-ro; removed by atomrust-rw.\n[Main]\nMechanism=zram\n' > "/$SWAP_DROPIN"
	fi

	: > "/$STATE"
	for t in $TIMERS; do
		if systemctl is-enabled --quiet "$t" 2>/dev/null; then
			systemctl disable --quiet "$t"
			echo "$t" >> "/$STATE"
		fi
	done

	fstab_boot_opt ro /etc/fstab

	with_boot_rw cmdline_add
	sync
	say "read-only mode configured. Reboot to activate; after that nothing is written to the SD card."
	maybe_reboot
}

do_rw() {
	if overlay_active; then
		root=$LOWER
		mount -o remount,rw "$root" || die "cannot remount $root read-write"
	elif overlay_configured; then
		root=""   # ro configured but not yet active: just undo it
	else
		say "already in read-write mode"; exit 0
	fi

	rm -f "$root/$JOURNALD_DROPIN" "$root/$SWAP_DROPIN"
	if [ -f "$root/$STATE" ]; then
		for t in $(cat "$root/$STATE"); do
			systemctl --root="${root:-/}" enable --quiet "$t" || true
		done
		rm -f "$root/$STATE"
	fi
	fstab_boot_opt rw "$root/etc/fstab"

	edit_real_cmdline
	sync
	[ -n "$root" ] && mount -o remount,ro "$root" 2>/dev/null || true
	say "read-write mode configured. Reboot to activate."
	maybe_reboot
}

# In read-only mode overlayroot may present $BOOT as an overlay too, in which
# case editing it would only change RAM. Edit the real partition instead.
edit_real_cmdline() {
	if [ "$(findmnt -n -o FSTYPE "$BOOT")" = vfat ]; then
		with_boot_rw cmdline_del
		return
	fi
	dev=$(findmnt -n -o SOURCE --fstab --tab-file "$LOWER/etc/fstab" "$BOOT")
	tmp=$(mktemp -d)
	mount "$dev" "$tmp" || die "cannot mount boot partition $dev"
	cmdline_del_at "$tmp/cmdline.txt"
	sync
	umount "$tmp" && rmdir "$tmp"
}
do_status() {
	if overlay_active; then
		echo "mode:      read-only (SD card root at $LOWER; writes go to RAM)"
		df -h --output=size,used,avail,pcent / | sed 's/^/overlay:  /'
	else
		echo "mode:      read-write"
	fi
	if overlay_configured; then echo "next boot: read-only"; else echo "next boot: read-write"; fi
	echo "boot:      $BOOT mounted $(findmnt -n -o OPTIONS "$BOOT" | cut -d, -f1)"
}

REBOOT=0
maybe_reboot() { if [ "$REBOOT" = 1 ]; then say "rebooting"; systemctl reboot; fi; }

PROG=$(basename "$0")
case "$PROG" in
	atomrust-ro) CMD=ro ;;
	atomrust-rw) CMD=rw ;;
	*) CMD=${1:-status}; [ $# -gt 0 ] && shift ;;
esac
for arg in "$@"; do
	case "$arg" in
		--reboot) REBOOT=1 ;;
		-h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) die "unknown argument: $arg" ;;
	esac
done

case "$CMD" in
	ro) need_root; do_ro ;;
	rw) need_root; do_rw ;;
	status) do_status ;;
	*) die "usage: atomrust-overlay {ro|rw|status} [--reboot]" ;;
esac
